# MouseJigger CoreInk (ESP32-PICO-D4 / 4MB) —— 工程默认配置
# 改了这里要 ./build.sh -c 后重编，旧 sdkconfig 不会自动吸收新默认值。

CONFIG_IDF_TARGET="esp32"

# ---- Flash：4MB / DIO / 80MHz（PICO-D4 内置 flash 必须 DIO）----
CONFIG_ESPTOOLPY_FLASHMODE_DIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="4MB"
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# ---- 省电：80MHz 上限 + 动态调频 + 自动浅睡 ----
# 蓝牙开着时控制器会持锁禁止浅睡（板上没有 32k 晶振，见 README），
# 这时只靠 DFS + BT modem sleep；模拟关闭 = 蓝牙整体关掉，才真正进入浅睡。
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_80=y
CONFIG_PM_ENABLE=y
CONFIG_FREERTOS_USE_TICKLESS_IDLE=y
CONFIG_FREERTOS_HZ=100
# RTC 慢时钟保持默认的 150kHz RC。不要换 8MD256：实测（IDF 5.4.2）它会让 ESP32
# 第一次进自动浅睡就卡死、再也醒不来。RC 慢时钟精度差（浅睡时系统时间会漂），
# 所以系统时间每分钟都用 BM8563 校正一次。

# ---- 蓝牙：仅 BLE + NimBLE ----
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BTDM_CTRL_MODE_BLE_ONLY=y
CONFIG_BTDM_CTRL_MODEM_SLEEP=y
CONFIG_BTDM_CTRL_MODEM_SLEEP_MODE_ORIG=y
CONFIG_BTDM_CTRL_LPCLK_SEL_MAIN_XTAL=y
CONFIG_BT_NIMBLE_NVS_PERSIST=y
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=1
CONFIG_BT_NIMBLE_MAX_BONDS=5
CONFIG_BT_NIMBLE_ROLE_CENTRAL=n
CONFIG_BT_NIMBLE_ROLE_OBSERVER=n
CONFIG_BT_NIMBLE_SM_SC=y
CONFIG_BT_NIMBLE_GAP_DEVICE_NAME_MAX_LEN=32
CONFIG_BT_NIMBLE_LOG_LEVEL_WARNING=y

# ---- HTTP：手机浏览器（尤其 iOS）请求头较长，默认 512 会回 431 ----
CONFIG_HTTPD_MAX_REQ_HDR_LEN=1024

# ---- IRAM：WiFi + BT + PM 同时开会溢出；WiFi 只是临时配置用，不需要它的性能优化 ----
CONFIG_ESP_WIFI_IRAM_OPT=n
CONFIG_ESP_WIFI_RX_IRAM_OPT=n
CONFIG_LWIP_IRAM_OPTIMIZATION=n

# ---- 其它 ----
# 主循环里会跑 esp_wifi_init / httpd_start / nimble 启停 / M5GFX 文字渲染，默认 3584 余量不明
CONFIG_ESP_MAIN_TASK_STACK_SIZE=6144
CONFIG_COMPILER_OPTIMIZATION_SIZE=y
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
